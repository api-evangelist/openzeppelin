                "description": "Network ID (e.g., evm:sepolia, solana:mainnet)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a network's configuration.\nCurrently supports updating RPC URLs only. Can be extended to support other fields."
        }
      ]
