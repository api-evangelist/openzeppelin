                "description": "Network ID (e.g., evm:sepolia, solana:mainnet)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves details of a specific network by ID."
